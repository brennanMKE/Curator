// The single source of truth for Curator's version. Don't set MARKETING_VERSION or
// CURRENT_PROJECT_VERSION in the project file; scripts/preflight.sh fails if you do.
//
// MARKETING_VERSION is what people see (X.Y.Z). CURRENT_PROJECT_VERSION is overridden at
// release time with the UTC build date and time (scripts/make-dmg.sh), so every release build
// is newer than the last.

MARKETING_VERSION = 0.0.3
CURRENT_PROJECT_VERSION = 1

// Sparkle updates. `//` starts a comment in xcconfig files, hence the HTTPS variable.
// Only Release builds get a feed URL, so Debug builds never try to update themselves.
HTTPS = https:/
SU_FEED_URL =
SU_FEED_URL[config=Release] = $(HTTPS)/curator.sstools.co/appcast.xml
// Public half of the EdDSA key in ~/.sparkle/Curator.key (see docs/releasing.md).
SU_PUBLIC_ED_KEY = Bb5uaj2ZXEalA2ArqCphMU7nj4GkNXHuExqUUOQYNsE=
